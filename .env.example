# Copia este archivo como .env.local y llena los valores de
# Supabase → Project Settings → API Keys. Nunca subas .env.local al repo.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: categorizar gastos con Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Política de datos (Decreto 1377 de 2013, art. 13): identificación del responsable.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_CITY=
PRIVACY_CONTROLLER_ADDRESS=
PRIVACY_CONTROLLER_PHONE=
PRIVACY_CONTACT_EMAIL=
